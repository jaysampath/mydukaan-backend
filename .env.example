# Copy to .env.dev and .env.prod. Never commit the real files.
#
# These are used by the contract tests and the schema generator, which talk to
# a Supabase project over HTTP exactly as the app does.

APP_ENV=dev
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# A seeded dev user the contract tests sign in as. Dev project only.
TEST_OWNER_EMAIL=owner.a@dev.local
TEST_OWNER_PASSWORD=devpassword123

# A seeded platform admin, for the admin contract test. Dev project only.
TEST_ADMIN_EMAIL=admin@dev.local
TEST_ADMIN_PASSWORD=devpassword123
